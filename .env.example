# Copy to .env and fill in, or export these before `npm start`.

# Signs the admin and play-session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SILHOUEDS_SECRET=

# The password for /admin.
SILHOUEDS_ADMIN_PASSWORD=

# Optional — enables "Sign in with Google", so a player's stats can follow them across devices.
# Anonymous play works exactly as before with these unset. Create an OAuth client (Web
# application) in Google Cloud Console, and add <your origin>/api/auth/google/callback as an
# authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional overrides.
# Fallback timezone, default Australia/Sydney. Players roll over at their own local midnight and
# the admin follows whoever is looking at it; this is the answer when no timezone is reported.
# SILHOUEDS_TIMEZONE=Australia/Sydney
# Silences the "data is not on a persistent disk" warning, if the data really is disposable.
# SILHOUEDS_ACCEPT_EPHEMERAL=true
# Absolute URL of the public site, used in the link-preview tags. Only needed behind a proxy
# that rewrites the host; otherwise the request's own host is used.
# SILHOUEDS_PUBLIC_URL=https://silhoueds.fly.dev
# PORT=3000
# SILHOUEDS_DB=data/silhoueds.db
# SILHOUEDS_UPLOADS=data/uploads
