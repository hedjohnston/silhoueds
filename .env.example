# Copy to .env and fill in, or export these before `npm start`.

# Signs the admin and play-session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SILHOUEDS_SECRET=

# The password for /admin.
SILHOUEDS_ADMIN_PASSWORD=

# Needed only for "Generate hints with Claude". The game runs fine without it.
ANTHROPIC_API_KEY=

# Optional overrides.
# Fallback timezone. Players roll over at their own local midnight; this is used for the admin's
# own "today" and when a visitor's timezone is unknown.
# SILHOUEDS_TIMEZONE=Australia/Sydney
# Silences the "data is not on a persistent disk" warning, if the data really is disposable.
# SILHOUEDS_ACCEPT_EPHEMERAL=true
# Absolute URL of the public site, used in the link-preview tags. Only needed behind a proxy
# that rewrites the host; otherwise the request's own host is used.
# SILHOUEDS_PUBLIC_URL=https://silhoueds.fly.dev
# PORT=3000
# SILHOUEDS_DB=data/silhoueds.db
# SILHOUEDS_UPLOADS=data/uploads
# SILHOUEDS_MODEL=claude-opus-5
